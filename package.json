{
  "name": "knowledge-os",
  "version": "4.0.0",
  "description": "A multidimensional knowledge graph system for database internals.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "repair:data": "node scripts/repair-data-integrity.mjs",
    "audit:duplicates": "node scripts/organize-duplicate-knowledge.mjs",
    "organize:data": "node scripts/organize-duplicate-knowledge.mjs --apply",
    "curate:data": "node scripts/curate-known-data.mjs --apply",
    "audit:semantic-duplicates": "node scripts/curate-semantic-duplicates.mjs",
    "curate:semantic-duplicates": "node scripts/curate-semantic-duplicates.mjs --apply",
    "audit:taxonomy": "node scripts/run-taxonomy-consolidation.mjs --check",
    "migrate:taxonomy": "node scripts/run-taxonomy-consolidation.mjs --apply",
    "setup:mineru": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ocr/setup-mineru.ps1",
    "import:jdk-collections": "node scripts/import-jdk-collections.mjs",
    "test": "node --test \"scripts/*.test.mjs\"",
    "audit:governance": "node scripts/knowledge-governance.mjs audit",
    "validate:governance": "node scripts/knowledge-governance.mjs validate",
    "generate:governance-candidates": "node scripts/knowledge-governance.mjs generate-candidates",
    "apply:governance-migration": "node scripts/apply-knowledge-governance-migration.mjs --apply",
    "resolve:governance-projections": "node scripts/resolve-cross-domain-projections.mjs --apply",
    "mount:governance-review": "node scripts/mount-governance-review-inbox.mjs --apply",
    "relocate:governance-source-view": "node scripts/relocate-mysql-glossary-source-view.mjs --apply",
    "apply:review-report": "node scripts/apply-review-report-migration.mjs --apply",
    "apply:low-confidence": "node scripts/apply-four-low-confidence-migration.mjs --apply"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "claude": "^0.1.1",
    "ipaddr.js": "^2.2.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.17.2",
    "npx": "^10.2.2",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "turndown": "^7.2.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
