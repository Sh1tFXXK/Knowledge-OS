import React, { useEffect, useRef, useCallback, useMemo } from 'react';
import { useGraphStore } from '../store/useGraph';
import { extractSubgraph } from '../knowledge/extractSubgraph';

/* ─── 区带定义 ─────────────────────────────────────────────── */
const ZONE_DEFS = [
  { zone: 'axiom',      label: '公理区', sub: '定义 / 常识',   color: '#8b5cf6', bg: 'rgba(139,92,246,0.08)',  border: 'rgba(139,92,246,0.30)' },
  { zone: 'mechanism',  label: '机制区', sub: '过程 / 方法',   color: '#ec4899', bg: 'rgba(236,72,153,0.08)',  border: 'rgba(236,72,153,0.30)'  },
  { zone: 'conclusion', label: '结论区', sub: '性质 / 能力',   color: '#06b6d4', bg: 'rgba(6,182,212,0.08)',   border: 'rgba(6,182,212,0.30)'   },
] as const;

/* 关系类型 → 颜色 */
const EDGE_COLOR: Record<string, string> = {
  'belongs-to': '#f59e0b',
  'leads-to':   '#10b981',
  'needs-for':  '#a855f7',
  'depends-on': '#ef4444',
  'enables':    '#3b82f6',
  'determines': '#06b6d4',
};
const edgeColor = (type: string) => EDGE_COLOR[type] ?? '#6b7280';

/* ─── 主组件 ────────────────────────────────────────────────── */
export default function ReasoningKernel() {
  /* store */
  const nodePool       = useGraphStore((s) => s.nodePool);
  const knowledgeEdges = useGraphStore((s) => s.knowledgeEdges);
  const selectedNodeId = useGraphStore((s) => s.selectedNodeId);
  const setSelectedNode = useGraphStore((s) => s.setSelectedNode);
  const dimension      = useGraphStore((s) => s.currentPerspective?.id ?? 'all');

  /* 提取局部子图 */
  const pack = useMemo(
    () =>
      extractSubgraph(nodePool, knowledgeEdges, {
        focus: selectedNodeId,
        scope: 'local',
        dimension,
      }),
    [nodePool, knowledgeEdges, selectedNodeId, dimension],
  );

  /* 按角色分组 */
  const grouped = useMemo(() => {
    const g: Record<string, typeof pack.nodes> = {
      axiom: [],
      mechanism: [],
      conclusion: [],
    };
    for (const n of pack.nodes) {
      const r = n.role ?? 'plain';
      if (r === 'axiom' || r === 'mechanism' || r === 'conclusion') {
        g[r].push(n);
      } else {
        // 把 plain / subsystem 节点按 zone 字段归组，否则放 mechanism
        const z = (n as any).zone ?? 'mechanism';
        (g[z] ?? g.mechanism).push(n);
      }
    }
    return g;
  }, [pack.nodes]);

  const isEmpty = pack.nodes.length === 0;

  /* ── SVG 尺寸 ─────────────────────────────────────── */
  const svgRef = useRef<SVGSVGElement>(null);
  const [dim, setDim] = React.useState({ w: 600, h: 480 });

  useEffect(() => {
    const obs = new ResizeObserver((entries) => {
      const el = entries[0]?.contentRect;
      if (el) setDim({ w: el.width, h: el.height });
    });
    const parent = svgRef.current?.parentElement;
    if (parent) {
      obs.observe(parent);
      const r = parent.getBoundingClientRect();
      setDim({ w: r.width, h: r.height });
    }
    return () => obs.disconnect();
  }, []);

  const { w, h } = dim;

  /* ── 漏斗几何 ─────────────────────────────────────── */
  // 三层各占 1/3 高度，宽度从宽→窄形成漏斗感
  const PADDING = 16;
  const ZONE_H  = (h - PADDING * 2) / 3;
  const zones = ZONE_DEFS.map((z, i) => {
    // 越靠下越窄
    const widthRatio = 1 - i * 0.15;
    const zw = (w - PADDING * 2) * widthRatio;
    const x  = PADDING + (w - PADDING * 2 - zw) / 2;
    const y  = PADDING + i * ZONE_H;
    return { ...z, x, y, zw, zh: ZONE_H - 8 };
  });

  /* 节点布局：在各区带内水平均匀排列 */
  function layoutNodes(zoneIdx: number, nodes: typeof pack.nodes) {
    const z = zones[zoneIdx];
    const n = nodes.length;
    if (n === 0) return [];
    const colW = z.zw / (n + 1);
    return nodes.map((nd, i) => ({
      ...nd,
      cx: z.x + colW * (i + 1),
      cy: z.y + z.zh / 2,
    }));
  }

  const laidOut = useMemo(() => {
    const rows = [
      layoutNodes(0, grouped.axiom),
      layoutNodes(1, grouped.mechanism),
      layoutNodes(2, grouped.conclusion),
    ];
    return rows.flat();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [grouped, dim]);

  const nodePos = useMemo(() => {
    const m = new Map<string, { cx: number; cy: number }>();
    laidOut.forEach((n) => m.set(n.id, { cx: (n as any).cx, cy: (n as any).cy }));
    return m;
  }, [laidOut]);

  /* ── 边路径 ─────────────────────────────────────────── */
  const edgePaths = useMemo(() => {
    return pack.edges.map((e) => {
      const from = nodePos.get(e.source);
      const to   = nodePos.get(e.target);
      if (!from || !to) return null;
      const mx = (from.cx + to.cx) / 2;
      const my = (from.cy + to.cy) / 2 - 20;
      return {
        id:    e.id,
        type:  e.type,
        label: e.label,
        d: `M ${from.cx} ${from.cy} Q ${mx} ${my} ${to.cx} ${to.cy}`,
        color: edgeColor(e.type),
        dimmed: e.dimmed,
        midX: mx,
        midY: my,
      };
    }).filter(Boolean) as Array<NonNullable<ReturnType<typeof pack.edges.map>[0]> & {
      d: string; color: string; midX: number; midY: number; label: string; dimmed: boolean;
    }>;
  }, [pack.edges, nodePos]);

  /* ── 角色颜色 ─────────────────────────────────────── */
  const roleColor = (role: string | undefined) => {
    if (role === 'axiom')      return '#8b5cf6';
    if (role === 'mechanism')  return '#ec4899';
    if (role === 'conclusion') return '#06b6d4';
    return '#94a3b8';
  };

  /* ── render ──────────────────────────────────────── */
  return (
    <div style={{ position: 'relative', width: '100%', height: '100%', overflow: 'hidden' }}>
      {/* 标题 */}
      <div className="graph-title" style={{ position: 'absolute', top: 8, left: 12, zIndex: 2 }}>
        <h2 style={{ fontSize: 13, margin: 0, opacity: 0.85 }}>推理内核 · 漏斗视图</h2>
        <p style={{ fontSize: 10, margin: 0, opacity: 0.4 }}>公理 → 机制 → 结论</p>
      </div>

      {/* 空状态 */}
      {isEmpty && (
        <div style={{
          position: 'absolute', inset: 0, display: 'flex',
          alignItems: 'center', justifyContent: 'center',
          fontSize: 12, color: 'rgba(148,163,184,0.5)', textAlign: 'center', padding: 32, zIndex: 1,
        }}>
          选中左侧目录节点<br />此处显示局部推理漏斗
        </div>
      )}

      {/* SVG 漏斗 */}
      <svg
        ref={svgRef}
        width="100%"
        height="100%"
        style={{ position: 'absolute', inset: 0 }}
      >
        <defs>
          {/* 各区带渐变 */}
          {ZONE_DEFS.map((z, i) => (
            <linearGradient key={z.zone} id={`zg-${z.zone}`} x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%"   stopColor={z.color} stopOpacity={0.04} />
              <stop offset="50%"  stopColor={z.color} stopOpacity={0.12} />
              <stop offset="100%" stopColor={z.color} stopOpacity={0.04} />
            </linearGradient>
          ))}
          {/* 箭头 marker */}
          {Object.entries(EDGE_COLOR).map(([type, color]) => (
            <marker
              key={type}
              id={`arr-${type}`}
              viewBox="0 0 10 10"
              refX="9" refY="5"
              markerWidth="6" markerHeight="6"
              orient="auto-start-reverse"
            >
              <path d="M 0 0 L 10 5 L 0 10 z" fill={color} opacity={0.8} />
            </marker>
          ))}
          <marker id="arr-default" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="#6b7280" opacity={0.6} />
          </marker>
          <filter id="glow">
            <feGaussianBlur stdDeviation="3" result="blur" />
            <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
          </filter>
        </defs>

        {/* 区带梯形背景 */}
        {zones.map((z, i) => {
          // 漏斗梯形：上宽下窄，每层越来越窄
          const nextW = i < 2 ? zones[i + 1].zw : z.zw - 40;
          const nextX = i < 2 ? zones[i + 1].x  : z.x + 20;
          const tl = { x: z.x,        y: z.y };
          const tr = { x: z.x + z.zw, y: z.y };
          const br = { x: nextX + nextW, y: z.y + z.zh };
          const bl = { x: nextX,        y: z.y + z.zh };
          const pts = `${tl.x},${tl.y} ${tr.x},${tr.y} ${br.x},${br.y} ${bl.x},${bl.y}`;
          return (
            <g key={z.zone}>
              <polygon
                points={pts}
                fill={`url(#zg-${z.zone})`}
                stroke={z.border}
                strokeWidth={1}
                strokeDasharray={i === 0 ? 'none' : '4 6'}
                opacity={0.9}
              />
              {/* 区带标签 */}
              <text
                x={z.x + 8}
                y={z.y + 16}
                fontSize={10}
                fill={z.color}
                opacity={0.85}
                fontWeight={600}
                letterSpacing={1}
              >
                {z.label}
              </text>
              <text
                x={z.x + 8}
                y={z.y + 28}
                fontSize={9}
                fill={z.color}
                opacity={0.45}
              >
                {z.sub}
              </text>
            </g>
          );
        })}

        {/* 边 */}
        {edgePaths.map((ep) => {
          const markerKey = Object.keys(EDGE_COLOR).includes(ep.type) ? ep.type : 'default';
          return (
            <g key={ep.id} opacity={ep.dimmed ? 0.2 : 0.75}>
              <path
                d={ep.d}
                fill="none"
                stroke={ep.color}
                strokeWidth={1.5}
                strokeDasharray={ep.dimmed ? '4 4' : undefined}
                markerEnd={`url(#arr-${markerKey})`}
              />
              {/* 边标签 */}
              {ep.label && (
                <text
                  x={ep.midX}
                  y={ep.midY - 4}
                  textAnchor="middle"
                  fontSize={9}
                  fill={ep.color}
                  opacity={0.7}
                >
                  {ep.label}
                </text>
              )}
            </g>
          );
        })}

        {/* 节点 */}
        {laidOut.map((n) => {
     