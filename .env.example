# OpenAI-compatible model used by the link importer. Keep the real key in .env.
KNOWLEDGE_OS_LLM_API_KEY=
KNOWLEDGE_OS_LLM_BASE_URL=https://api.openai.com/v1
KNOWLEDGE_OS_LLM_MODEL=gpt-4.1-mini

# Local MinerU OCR. `npm run setup:mineru` installs the default command below.
KNOWLEDGE_OS_MINERU_COMMAND=
KNOWLEDGE_OS_MINERU_BACKEND=pipeline
KNOWLEDGE_OS_MINERU_LANGUAGE=ch
KNOWLEDGE_OS_MINERU_TIMEOUT_MS=7200000
