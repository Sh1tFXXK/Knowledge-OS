# Local MinerU OCR. `npm run setup:mineru` installs the default command below.
KNOWLEDGE_OS_MINERU_COMMAND=
KNOWLEDGE_OS_MINERU_BACKEND=pipeline
KNOWLEDGE_OS_MINERU_LANGUAGE=ch
KNOWLEDGE_OS_MINERU_TIMEOUT_MS=7200000

# 只读部署标记（构建期开关，默认不设 = 可写）。
# 判定规则见 scripts/deploy/read-only-flag.mjs；客户端消费点见
# src/knowledge/deploymentMode.ts。
#   - Vercel 构建走 `npm run vercel-build`，自动置 1，不需要在后台配置
#   - 本地 `npm run build` 不设 ⇒ 产物可写（配 vite preview 做验收）
#   - 本地想验证只读产物：KNOWLEDGE_OS_READ_ONLY=1 npm run build
#   - 反过来的逃生口：KNOWLEDGE_OS_READ_ONLY=0 可压过 VERCEL=1
KNOWLEDGE_OS_READ_ONLY=
