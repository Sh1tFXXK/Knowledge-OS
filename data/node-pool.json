    "card": {
      "nodeId": "demo_lock",
      "title": "锁机制",
      "tabs": [
        {
          "id": "def",
          "label": "定义",
          "content": "保证并发访问时数据一致性的核心机制，通过控制数据访问顺序避免冲突。"
        },
        {
          "id": "mech",
          "label": "机制",
          "content": "InnoDB 支持行锁、表锁、间隙锁、Next-Key Lock；按粒度/类型/策略可分四个维度。"
        },
        {
          "id": "bound",
          "label": "边界",
          "content": "锁粒度越细并发越高，但开销越大；死锁需靠事务顺序和索引设计规避。"
        },
        {
          "id": "source",
          "label": "来源",
          "content": "InnoDB 锁实现 · MySQL 官方文档"
        }
      ]
    }
  },
  "demo_deadlock": {
    "id": "demo_deadlock",
    "label": "死锁检测",
    "role": "mechanism",
    "dimensions": [
      "transaction"
    ],
    "card": {
      "nodeId": "demo_deadlock",
      "title": "死锁检测",
      "tabs": [
        {
          "id": "def",
          "label": "定义",
          "content": "多个事务循环等待对方持有的锁导致永久阻塞。"
        },
        {
          "id": "mech",
          "label": "机制",
          "content": "InnoDB 维护事务等待图（wait-for graph），每次加锁请求时检测图中是否存在环，若存在则选择回滚代价最小的事务（undo 行数最少）。"
        },
        {
          "id": "bound",
          "label": "边界",
          "content": "合理的事务顺序（按主键升序更新）和缩短持锁时间可大幅减少死锁。"
        },
        {
          "id": "source",
          "label": "来源",
          "content": "InnoDB 死锁检测算法 · lock0lock.cc"
        }
      ]
    }
  },
  "demo_table_lock": {
    "id": "demo_table_lock",
    "label": "表级锁",
    "locked": true,
    "role": "mechanism",
    "dimensions": [
      "transaction",
      "storage"
    ],
    "card": {
      "nodeId": "demo_table_lock",
      "title": "表级锁",
      "tabs": [
        {
          "id": "def",
          "label": "定义",
          "content": "对整张表加锁，所有行共享同一把锁。"
        },
        {
          "id": "mech",
          "label": "机制",
          "content": "读锁允许并发读、阻塞写；写锁阻塞所有读写。DDL 操作隐式加表锁。"
        },
        {
          "id": "bound",
          "label": "边界",
          "content": "无 Gap Lock 概念（整表即边界）；加锁顺序是全序，不会形成循环等待。"
        },
        {
          "id": "source",
          "label": "来源",
          "content": "MySQL LOCK TABLES 语法"
        }
      ]
    }
  },
  "demo_row_lock": {
    "id": "demo_row_lock",
    "label": "行级锁",
    "locked": true,
    "role": "mechanism",
    "dimensions": [
      "transaction",
      "performance"
    ],
    "card": {
      "nodeId": "demo_row_lock",
      "title": "行级锁",
      "tabs": [
        {
          "id": "def",
          "label": "定义",
          "content": "对索引记录加锁，仅影响被访问的行。"
        },
        {
          "id": "mech",
          "label": "机制",
          "content": "Record Lock 锁索引记录，Gap Lock 锁间隙，Next-Key Lock 锁记录+前间隙。基于索引实现——未命中索引则升级为表锁。"
        },
        {
          "id": "bound",
          "label": "边界",
          "content": "同一事务可持有多个行锁——不同事务以不同顺序锁定行时，可能形成循环等待。"
        },
        {
          "id": "source",
          "label": "来源",
          "content": "InnoDB 官方文档 · row0sel.cc"
        }
      ]
    }
  },
  "demo_page_lock": {
    "id": "demo_page_lock",
    "label": "页面锁",
    "locked": true,
    "role": "mechanism",
    "dimensions": [
      "storage"
    ],
    "card": {
      "nodeId": "demo_page_lock",
      "title": "页面锁",
      "tabs": [
